{
  "name": "emoji2smile",
  "version": "1.2.2",
  "description": "Convert emoji characters into Western text emoticons or Japanese-style kaomoji.",
  "license": "MIT",
  "main": "./src/index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "emoji",
    "emoticon",
    "smiley",
    "text",
    "unicode",
    "converter"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Scratcherbin/emoji2smile.git"
  },
  "homepage": "https://github.com/Scratcherbin/emoji2smile#readme",
  "bugs": {
    "url": "https://github.com/Scratcherbin/emoji2smile/issues"
  }
}
